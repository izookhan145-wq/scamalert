# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MODELSCOPE_API_KEY: Required for ModelScope API-Inference calls.
# Add your ModelScope access token in the AI Studio Settings > Secrets panel.
MODELSCOPE_API_KEY=""

# MODELSCOPE_MODEL: ModelScope model ID (e.g. Qwen/Qwen2.5-72B-Instruct or Qwen/Qwen2.5-7B-Instruct).
MODELSCOPE_MODEL="Qwen/Qwen2.5-72B-Instruct"

# MODELSCOPE_BASE_URL: OpenAI-compatible ModelScope inference endpoint.
MODELSCOPE_BASE_URL="https://api-inference.modelscope.cn/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
